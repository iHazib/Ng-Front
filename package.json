{
  "name": "nook-and-glow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "10.x || 11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src scripts tests tooling next.config.ts playwright.config.ts eslint.config.mjs --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.build.json",
    "styles:extract": "node scripts/extract-reference.mjs",
    "sources:check": "node scripts/verify-sources.mjs",
    "check": "npm run sources:check && npm run lint && npm run typecheck && npm run build",
    "test:browser": "playwright test",
    "test:production": "node scripts/check-production.mjs",
    "test:admin:unit": "node --conditions=react-server --test tests/admin-security.test.mjs tests/media-service.test.mjs",
    "verify:admin:development": "node scripts/verify-admin-development.mjs --run-development",
    "verify:admin:usability": "node scripts/verify-admin-usability.mjs --run-development",
    "verify:storefront:development": "node scripts/verify-storefront-development.mjs --run-development",
    "verify:storefront:mock-ui": "node scripts/verify-storefront-ui-mock.mjs",
    "sql:storefront": "node scripts/prepare-storefront-sql.mjs",
    "sql:daily-editor": "node scripts/prepare-daily-editor-sql.mjs",
    "sql:content": "node scripts/prepare-content-sql.mjs",
    "test:content:unit": "node --conditions=react-server --test tests/content-security.test.mjs",
    "verify:content:development": "node scripts/verify-content-development.mjs --run-development",
    "verify:content:mock-ui": "node scripts/verify-content-ui-mock.mjs",
    "sql:reviews": "python tooling/prepare-reviews.py && node scripts/prepare-reviews-sql.mjs",
    "test:reviews:unit": "node --conditions=react-server --test tests/reviews-security.test.mjs",
    "verify:reviews:setup": "node scripts/check-reviews-setup.mjs",
    "verify:reviews:mock-ui": "node scripts/verify-reviews-ui-mock.mjs",
    "sql:product-markdown": "node scripts/prepare-product-markdown-sql.mjs",
    "test:product-markdown": "node --test tests/product-markdown.test.mjs",
    "verify:admin:refresh-mock": "node scripts/verify-admin-refresh-ui-mock.mjs",
    "sql:commerce": "node scripts/prepare-commerce-sql.mjs",
    "test:commerce:validation": "node --test tests/commerce-validation.test.mjs",
    "verify:commerce:development": "node scripts/verify-manual-payments-development.mjs --run-development",
    "verify:commerce:mock-ui": "node scripts/verify-commerce-ui-mock.mjs",
    "commerce:maintenance": "node scripts/commerce-maintenance.mjs",
    "dev:commerce:test": "node scripts/start-commerce-verification.mjs",
    "sql:manual-payments": "node scripts/prepare-manual-payments-sql.mjs",
    "test:manual-payments:unit": "node --test tests/manual-payments.test.mjs",
    "verify:manual-payments:readonly": "node scripts/check-manual-payments-live-readonly.mjs",
    "verify:manual-payments:mock-ui": "node scripts/verify-manual-payments-ui-mock.mjs",
    "verify:manual-payments:development": "node scripts/verify-manual-payments-development.mjs --run-development",
    "verify:manual-payments:admin-mock": "node scripts/verify-manual-payment-admin-ui-mock.mjs",
    "sql:deals": "node scripts/prepare-deals-sql.mjs",
    "test:deals:unit": "node --test tests/deals.test.mjs",
    "verify:deals:mock-ui": "node scripts/verify-deals-ui-mock.mjs",
    "verify:deals:readonly": "node scripts/check-deals-live-readonly.mjs",
    "verify:deals:public-mock": "node scripts/verify-deals-public-mock.mjs",
    "sql:reports": "node scripts/prepare-reports-sql.mjs",
    "test:reports:unit": "node --test tests/reports-csv.test.mjs",
    "verify:reports:mock-ui": "node scripts/verify-reports-ui-mock.mjs",
    "verify:reports:readonly": "node scripts/check-reports-live-readonly.mjs",
    "verify:reports:development": "node scripts/verify-reports-development.mjs --run-development",
    "sql:partial-refunds": "node scripts/prepare-partial-refunds-sql.mjs",
    "test:seo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/seo-policy.test.mjs && node scripts/verify-seo.mjs",
    "measure:seo": "node scripts/measure-web-vitals.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.12.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
