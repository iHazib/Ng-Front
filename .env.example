# Copy to .env.local; never put actual secrets in this file.
# APP_ENV: development, staging, or production. Default is development locally,
# staging for a production build. Production storefront is not enabled yet.
APP_ENV=
# Set only after the production domain is approved, e.g. an absolute HTTPS URL.
SITE_URL=
# Required for any non-development preview. Use HTTPS at the hosting boundary.
PREVIEW_USERNAME=
# Generate a unique random password of at least 32 characters. Server-only.
PREVIEW_PASSWORD=
# Actual catalog is the default. Sample content requires an explicit local next-dev preview.
# Values: supabase (default), sample-preview (development only; never production builds).
STOREFRONT_DATA_MODE=
# Supabase project used by public catalog RPCs and authorized admin operations.
# URL and publishable key are public identifiers; never put a secret key in these names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key for the narrowly scoped guest review gateway.
# Admin operations continue to use verified Auth sessions and RLS. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional local/test migration connection for a manually configured Supabase CLI.
# Never commit credentials or use a production URL for the disposable test runner.
SUPABASE_DB_URL=
# Server-only Cloudinary media service. Use a separate development product environment.
# Never prefix API keys/secrets with NEXT_PUBLIC_. Dynamic folder mode required.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Explicitly development, staging or production; no implicit production fallback.
MEDIA_ENVIRONMENT=

# Reviews: generate at least 32 random characters locally. Signs guest sessions and hashes rate keys.
REVIEW_SESSION_SECRET=
# Production only: cf-connecting-ip or x-vercel-forwarded-for, ONLY when the configured
# hosting ingress strips user-supplied versions of this header. No generic forwarded headers.
# Development uses a shared loopback quota. Other hosts need a reviewed trusted ingress adapter.
REVIEWS_TRUSTED_IP_HEADER=

# Commerce: disabled until incremental 016 and business settings are approved.
# Server-only; never prefix these names with NEXT_PUBLIC_.
COMMERCE_ENABLED=
# Structured shipping/payment/tax-treatment configuration; see docs/manual-payments-setup.md.
# Leave blank instead of guessing real charges, cities, thresholds or payment options.
COMMERCE_CONFIG_JSON=
# Optional independent 32+ character signing secret. Existing REVIEW_SESSION_SECRET is
# reused with a separate commerce HMAC namespace if this is unset. Rotate deliberately.
COMMERCE_SESSION_SECRET=
# Trusted ingress-stripped IP header only, as for reviews. Required outside local development.
COMMERCE_TRUSTED_IP_HEADER=

# Manual advance payment configuration (incremental 016)
# COMMERCE_CONFIG_JSON additionally requires owner-chosen paymentSeconds and
# reviewExtensionSeconds, and enabled bank-transfer/easypaisa/jazzcash receiving
# details: label, accountTitle, destination, instructions; bank-transfer bankName.
# Missing receiving details disable that method. COD/gateways are unsupported.
# See docs/manual-payments-setup.md. Never put real account details in this file.
